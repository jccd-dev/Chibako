{
  "name": "chibako",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted second brain: markdown notes, wikilinks, backlinks, graph, and token-efficient AI agent access (REST + MCP).",
  "overrides": {
    "braces": "^3.0.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:mcp",
    "start": "next start",
    "lint": "eslint src tests \"*.{js,cjs,mjs,ts,tsx}\" --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:mcp-stdio": "npm run build:mcp && node --import tsx tests/mcp-stdio.smoke.ts && node --import tsx tests/finance-stdio.smoke.ts",
    "test:e2e": "playwright test",
    "build:mcp": "esbuild src/mcp/server.ts --bundle --platform=node --format=esm --external:better-sqlite3 --outfile=dist/mcp/server.mjs",
    "mcp": "node dist/mcp/server.mjs",
    "mcp:dev": "tsx src/mcp/server.ts",
    "build:memory-plugins": "node scripts/build-memory-plugins.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tabler/icons-react": "^3.46.0",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "date-fns": "^4.4.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.28",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "js-yaml": "4.3.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
