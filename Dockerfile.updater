# Companion updater: owns pull, backup, pin switching, health gating and rollback.
# It holds the Docker socket (host-root equivalent), so it is a separate image
# from the app, runs no network listener, and only acts on host-owned config.
FROM node:24-bookworm-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY src/features/updates/protocol.ts src/features/updates/protocol.ts
COPY updater updater
RUN npx esbuild updater/main.ts --bundle --platform=node --format=esm --outfile=/out/updater.mjs

FROM node:24-bookworm-slim AS runtime
ENV NODE_ENV=production
ARG CHIBAKO_VERSION=0.0.0
ARG CHIBAKO_COMMIT=unknown
# util-linux provides flock(1), shared with host-side deploy tooling.
RUN apt-get update \
  && apt-get upgrade -y \
  && apt-get install -y --no-install-recommends util-linux \
  && rm -rf /var/lib/apt/lists/* /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
COPY --from=docker:28-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:28-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=build /out/updater.mjs /usr/local/lib/chibako-updater.mjs
LABEL org.opencontainers.image.source="https://github.com/jccd-dev/chibako" \
      org.opencontainers.image.version=$CHIBAKO_VERSION \
      org.opencontainers.image.revision=$CHIBAKO_COMMIT
# Root is required for the Docker socket and for restoring a root-or-uid-1000-owned vault.
ENTRYPOINT ["node", "/usr/local/lib/chibako-updater.mjs"]
CMD ["daemon"]
