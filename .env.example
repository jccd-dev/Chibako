# Copy to .env (or .env.local for dev). All values optional — sensible defaults exist.

# Directory where the SQLite brain lives (note: must be writable by the app).
DATA_DIR=./data

# Secret used to sign session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random value is generated at boot (sessions reset on restart).
SESSION_SECRET=

# Optional: name shown in the UI.
SITE_NAME=Chibako

# Port for `next start` (Docker uses this).
PORT=3000