# Copy to .env (or .env.local for dev).

# Required only for first setup. Generate with: openssl rand -hex 32
# Enter the same token in the setup form, then remove it after setup.
CHIBAKO_SETUP_TOKEN=

# Enable only behind a proxy that overwrites X-Chibako-Client-IP and blocks
# direct access to the app. Otherwise all clients share the five-attempt limit.
CHIBAKO_TRUST_PROXY=false

# Directory where the SQLite brain lives (note: must be writable by the app).
DATA_DIR=./data

# Optional: name shown in the UI.
SITE_NAME=Chibako

# Port for `next start` (Docker uses this).
PORT=3000

# --- Optional semantic recall (embeddings) ---
# Disabled by default. To enable vector search fused with BM25, set these.
# Any OpenAI-compatible /v1/embeddings endpoint works (OpenAI, OpenRouter, etc).
# Embeddings refresh automatically when notes change and can be repaired from
# Settings -> Recall (Reindex now). Use CHIBAKO_EMBEDDING_PROVIDER=fake only for tests.
# CHIBAKO_EMBEDDING_PROVIDER=openai
# CHIBAKO_EMBEDDING_API_KEY=
# CHIBAKO_EMBEDDING_MODEL=text-embedding-3-small
# CHIBAKO_EMBEDDING_BASE_URL=https://api.openai.com/v1
# CHIBAKO_EMBEDDING_DIM=1536
